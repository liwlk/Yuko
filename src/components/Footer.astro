---
import { DISCORD_INVITE_URL, NAV_ITEMS } from '../data/yuko';

export interface Props {
  variant?: 'monument' | 'compact';
  currentPath: string;
  nextHref?: string;
  nextLabel?: string;
  summary?: string;
}

const {
  variant = 'compact',
  currentPath,
  nextHref,
  nextLabel,
  summary,
} = Astro.props;

const normalizedPath =
  currentPath === '/' ? '/' : currentPath.endsWith('/') ? currentPath : `${currentPath}/`;

const PAGE_ANCHORS: Record<string, Array<{ href: string; label: string }>> = {
  '/': [
    { href: '#continuidade', label: 'Continuidade na Prática' },
    { href: '#pilares', label: 'Como funciona' },
    { href: '#atuacao', label: 'Parceria Assistida' },
    { href: '#simulador', label: 'Simulador' },
    { href: '#manual', label: 'Manual & Discord' },
  ],
  '/extensoes/': [
    { href: '#fundamentos', label: 'Origem & Pilares' },
    { href: '#extensoes', label: '6 Extensões' },
    { href: '#frentes', label: '6 Frentes' },
    { href: '#discord', label: 'Discord' },
  ],
  '/ciclo/': [
    { href: '#etapas', label: '6 Etapas' },
    { href: '#papeis', label: 'Papéis & Continuidade' },
    { href: '#registro', label: 'Ficha do Projeto' },
  ],
  '/governanca/': [
    { href: '#engenharia', label: 'Qualidade & Conferência' },
    { href: '#seguranca', label: 'Segurança' },
    { href: '#privacidade', label: 'LGPD & Mediação' },
  ],
  '/manual/': [
    { href: '#controle', label: 'Quadro de Controle' },
    { href: '#origem', label: 'Ressalvas & Linhagem' },
    { href: '#glossario', label: 'Glossário' },
  ],
};

const resolvedAnchors = PAGE_ANCHORS[normalizedPath] ?? PAGE_ANCHORS['/'];

const defaultSummary =
  variant === 'monument'
    ? 'Comunidade técnica brasileira que une desenvolvedores independentes e microempresas em parceria assistida: trabalho autônomo validado por 2+ pares, repositório central sem lock-in e continuidade organizada.'
    : 'Comunidade técnica que une desenvolvedores independentes e microempresas em parceria assistida, com revisão por 2+ pares, repositório central e continuidade.';

const resolvedSummary = summary ?? defaultSummary;
const isMonument = variant === 'monument';
---

<footer class={isMonument ? 'site-footer' : 'site-footer site-footer-compact'}>
  <div class="container">
    <div class="footer-top">
      <div>
        <a href="/" class="brand">
          <span>Yuko</span>
        </a>
        <p class="footer-summary">{resolvedSummary}</p>
        {nextHref && nextLabel ? (
          <a href={nextHref} class="btn btn-primary btn-sm">{nextLabel}</a>
        ) : (
          <a href="#topo-pagina" class="btn btn-tonal btn-sm">Voltar ao topo</a>
        )}
      </div>

      <div class="footer-cols">
        <div>
          <div class="footer-col-title">{isMonument ? 'Navegação' : 'Subpáginas'}</div>
          <nav
            class="footer-col-links"
            aria-label={isMonument ? 'Navegação institucional' : 'Subpáginas'}
          >
            {NAV_ITEMS.map((item) => (
              <a
                href={item.href}
                aria-current={normalizedPath === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))}
            <a
              href={DISCORD_INVITE_URL}
              target="_blank"
              rel="noopener noreferrer"
            >
              Discord Oficial ↗
            </a>
          </nav>
        </div>

        <div>
          <div class="footer-col-title">Nesta Página</div>
          <nav class="footer-col-links" aria-label="Âncoras desta página">
            {resolvedAnchors.map((anchor) => (
              <a href={anchor.href}>{anchor.label}</a>
            ))}
          </nav>
        </div>
      </div>
    </div>

    {isMonument && (
      <div class="footer-monument">
        <div class="footer-monument-head">
          <span class="footer-ref-kicker">
            Comunidade Técnica Brasileira · Chancela Coletiva
          </span>
          <div class="footer-monument-logo">
            <img src="/assets/yuko-logo.jpg" alt="Marca Yuko" />
          </div>
        </div>

        <span class="footer-wordmark">YUKO</span>

        <div class="footer-monument-sub">
          <span class="footer-monument-tagline">
            Trabalho individual validado coletivamente · Sem caixa-preta, sem isolamento
          </span>
        </div>
      </div>
    )}

    <div class="footer-inner">
      <span><strong>Yuko</strong> · Manual Institucional v1.0</span>
      <div class="footer-links">
        {isMonument ? (
          <a href="#topo-pagina">Topo</a>
        ) : (
          <>
            {NAV_ITEMS.map((item) => (
              <a
                href={item.href}
                aria-current={normalizedPath === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))}
            <a href="#topo-pagina">Topo</a>
          </>
        )}
      </div>
    </div>
  </div>
</footer>
