---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  DISCORD_INVITE_URL,
  IDENTITY_PILLARS,
  VISUAL_RULES,
  EXTENSIONS,
  FRONTS,
  DISCORD_CHANNELS,
} from '../data/yuko';

const frontColA = FRONTS.slice(0, 3);
const frontColB = FRONTS.slice(3);
const channelItems = DISCORD_CHANNELS.filter((item) => item.kind === 'channel');
const guidelineItems = DISCORD_CHANNELS.filter((item) => item.kind === 'guideline');
---

<BaseLayout
  title="Extensões, Frentes & Discord — Yuko"
  description="Valores da marca Yuko (Yukon, Oslo, Verona), as 6 áreas de atuação (Field, Dev, Make, Place, Work, Inline), 6 frentes de trabalho e nosso servidor no Discord."
  currentPath="/extensoes/"
  footerVariant="compact"
  nextHref="/ciclo/"
  nextLabel="Avançar para Ciclo & Papéis →"
>
  <section class="sub-hero">
    <div class="container">
      <div class="section-kicker">Como a Yuko se organiza</div>
      <h1 class="sub-hero-title">
        Identidade, <span class="accent-word">Extensões</span> &amp; Frentes
      </h1>
      <p class="hero-lead">
        Nossos valores visuais, seis áreas práticas de atuação, seis frentes de trabalho e o ponto de encontro da comunidade no Discord.
      </p>
      <div class="hero-actions" style="margin-bottom:0">
        <a href="#extensoes" class="btn btn-primary">6 Extensões</a>
        <a href="#fundamentos" class="btn btn-tonal">Valores</a>
        <a href="#frentes" class="btn btn-tonal">6 Frentes</a>
        <a href="#discord" class="btn btn-outline">Discord</a>
      </div>
    </div>
  </section>

  <!-- Fundamentos e Diretrizes Visuais -->
  <section id="fundamentos" class="section" style="padding-top:24px">
    <div class="container">
      <div class="section-head">
        <div class="section-kicker">Fundamentos &amp; Identidade</div>
        <h2 class="section-title">De onde vem a Yuko e como nos apresentamos</h2>
      </div>

      <div class="lab-panel">
        <div class="grid-3">
          {IDENTITY_PILLARS.map((pillar) => (
            <div>
              <h3 style="margin-bottom:8px">{pillar.title}</h3>
              <p style="margin:0">{pillar.description}</p>
            </div>
          ))}
        </div>

        <div class="grid-3" style="margin-top:24px">
          {VISUAL_RULES.map((rule) => (
            <div>
              <h3 style="margin-bottom:8px">{rule.title}</h3>
              <p style="margin:0">{rule.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Sistema de Extensões -->
  <section id="extensoes" class="section">
    <div class="container">
      <div class="section-head">
        <div class="section-kicker">Áreas da Marca</div>
        <h2 class="section-title">Seis extensões sob o nome Yuko</h2>
        <p class="section-desc">
          Cada extensão identifica uma parte prática do nosso trabalho — da conversa com a empresa às automações.
        </p>
      </div>

      <div class="grid-3">
        {EXTENSIONS.map((ext) => (
          <article class={ext.tone === 'default' ? 'm3-card' : `m3-card ${ext.tone}`}>
            <div>
              <h3 style="margin-bottom:8px">{ext.name}</h3>
              <p>{ext.description}</p>
            </div>
            <span class="card-code">{ext.code}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- As Seis Frentes de Atuação -->
  <section id="frentes" class="section">
    <div class="container">
      <div class="section-head">
        <div class="section-kicker">Frentes de Atuação</div>
        <h2 class="section-title">Seis frentes integradas de trabalho</h2>
        <p class="section-desc">
          Enquanto as extensões dão nome às áreas visíveis ao público, as frentes organizam as disciplinas internas aplicadas em cada projeto.
        </p>
      </div>

      <div class="lab-panel">
        <div class="grid-2">
          <ul class="clean-list">
            {frontColA.map((front) => (
              <li>
                <span>
                  <strong>{front.title}</strong> — {front.description}
                </span>
              </li>
            ))}
          </ul>

          <ul class="clean-list">
            {frontColB.map((front) => (
              <li>
                <span>
                  <strong>{front.title}</strong> — {front.description}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Comunidade & Discord -->
  <section id="discord" class="section">
    <div class="container">
      <div class="section-head">
        <div class="section-kicker">Ponto de Encontro</div>
        <h2 class="section-title">Servidor Discord</h2>
        <p class="section-desc">
          É no Discord que desenvolvedores independentes se reúnem para tirar dúvidas, combinar tarefas e acompanhar projetos ativos.
        </p>
      </div>

      <div class="m3-card tonal-secondary">
        <div class="grid-2">
          <div>
            <h3 style="margin-bottom:14px">Estrutura dos canais</h3>
            <ul class="clean-list">
              {channelItems.map((item) => (
                <li>
                  <span>
                    <strong>{item.title}:</strong> {item.description}
                  </span>
                </li>
              ))}
            </ul>
          </div>

          {guidelineItems.map((item) => (
            <div>
              <h3 style="margin-bottom:8px">{item.title}</h3>
              <p>{item.description}</p>
            </div>
          ))}
        </div>

        <div class="hero-actions" style="margin-top:8px;margin-bottom:0">
          <a
            href={DISCORD_INVITE_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
          >
            Entrar no servidor do Discord ↗
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
