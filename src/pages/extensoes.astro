---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  DISCORD_INVITE_URL,
  LINEAGE_STAGES,
  IDENTITY_PILLARS,
  VISUAL_RULES,
  EXTENSIONS,
  FRONTS,
  DISCORD_CHANNELS,
} from '../data/yuko';

const frontColA = FRONTS.slice(0, 3);
const frontColB = FRONTS.slice(3);
const channelItems = DISCORD_CHANNELS.filter((item) => item.kind === 'channel');
const guidelineItems = DISCORD_CHANNELS.filter((item) => item.kind === 'guideline');
---

<BaseLayout
  title="Origem, Pilares, 6 Extensões & Discord — Yuko"
  description="Da trajetória NYX e Expliance aos pilares Yukon, Oslo e Verona: conheça as 6 extensões da Yuko, as 6 frentes internas e nosso ponto de encontro voluntário no Discord."
  ogImageAlt="Origem, pilares Yukon, Oslo e Verona, 6 extensões e comunidade Discord da Yuko"
  currentPath="/extensoes/"
  footerVariant="compact"
  nextHref="/ciclo/"
  nextLabel="Avançar para Ciclo & Papéis →"
>
  <section class="sub-hero">
    <div class="container">
      <div class="section-kicker">De onde viemos e como nos organizamos</div>
      <h1 class="sub-hero-title">
        Origem, Pilares &amp; <span class="accent-word">Extensões</span>
      </h1>
      <p class="hero-lead">
        Conheça a caminhada da Yuko, os valores por trás do nome, as 6 extensões de atuação, as 6 frentes internas e nosso Discord de participação voluntária.
      </p>
      <div class="hero-actions" style="margin-bottom:0">
        <a href="#extensoes" class="btn btn-primary">6 Extensões</a>
        <a href="#fundamentos" class="btn btn-tonal">Origem &amp; Pilares</a>
        <a href="#frentes" class="btn btn-tonal">6 Frentes</a>
        <a href="#discord" class="btn btn-outline">Discord</a>
      </div>
    </div>
  </section>

  <!-- Fundamentos e Diretrizes Visuais -->
  <section id="fundamentos" class="section" style="padding-top:24px">
    <div class="container">
      <div class="section-head">
        <div class="section-kicker">Fundamentos &amp; Identidade</div>
        <h2 class="section-title">De onde vem a Yuko e como nos apresentamos</h2>
        <p class="section-desc">
          A Yuko nasceu como síntese de uma ponte técnica em duas fases precursoras — simplificando o caminho sem abrir mão do rigor e do registro.
        </p>
      </div>

      <div class="lab-panel">
        <div class="grid-3" style="margin-bottom:24px">
          {LINEAGE_STAGES.map((stage) => (
            <div>
              <h3 style="margin-bottom:8px">{stage.title}</h3>
              <p style="margin:0">{stage.description}</p>
            </div>
          ))}
        </div>

        <div class="grid-3">
          {IDENTITY_PILLARS.map((pillar) => (
            <div>
              <h3 style="margin-bottom:8px">{pillar.title}</h3>
              <p style="margin:0">{pillar.description}</p>
            </div>
          ))}
        </div>

        <div class="grid-3" style="margin-top:24px">
          {VISUAL_RULES.map((rule) => (
            <div>
              <h3 style="margin-bottom:8px">{rule.title}</h3>
              <p style="margin:0">{rule.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Sistema de Extensões -->
  <section id="extensoes" class="section">
    <div class="container">
      <div class="section-head">
        <div class="section-kicker">Portas Públicas da Marca</div>
        <h2 class="section-title">6 extensões como portas públicas da Yuko</h2>
        <p class="section-desc">
          As 6 extensões são as portas públicas sob a marca Yuko — evoluem de forma gradual, sem exigir equipe fixa.
        </p>
      </div>

      <div class="grid-3">
        {EXTENSIONS.map((ext) => (
          <article class={ext.tone === 'default' ? 'm3-card' : `m3-card ${ext.tone}`}>
            <div>
              <h3 style="margin-bottom:8px">{ext.name}</h3>
              <p>{ext.description}</p>
            </div>
            <span class="card-code">{ext.code}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- As Seis Frentes de Atuação -->
  <section id="frentes" class="section">
    <div class="container">
      <div class="section-head">
        <div class="section-kicker">Engrenagens nos Bastidores</div>
        <h2 class="section-title">Seis frentes internas de atuação</h2>
        <p class="section-desc">
          Se as extensões funcionam como portas de entrada da Yuko, as 6 frentes internas são as engrenagens disciplinares combinadas nos bastidores de cada projeto.
        </p>
      </div>

      <div class="lab-panel">
        <div class="grid-2">
          <ul class="clean-list">
            {frontColA.map((front) => (
              <li>
                <span>
                  <strong>{front.title}</strong> — {front.description}
                </span>
              </li>
            ))}
          </ul>

          <ul class="clean-list">
            {frontColB.map((front) => (
              <li>
                <span>
                  <strong>{front.title}</strong> — {front.description}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Comunidade & Discord -->
  <section id="discord" class="section">
    <div class="container">
      <div class="section-head">
        <div class="section-kicker">Convivência Diária &amp; Autônoma</div>
        <h2 class="section-title">Servidor Discord</h2>
        <p class="section-desc">
          Nosso ponto de encontro no Discord reúne desenvolvedores voluntários e autônomos — sem vínculo empregatício ou societário — para trocar ideias, tirar dúvidas e tocar projetos ativos.
        </p>
      </div>

      <div class="m3-card tonal-secondary">
        <div class="grid-2">
          <div>
            <h3 style="margin-bottom:14px">Estrutura dos canais</h3>
            <ul class="clean-list">
              {channelItems.map((item) => (
                <li>
                  <span>
                    <strong>{item.title}:</strong> {item.description}
                  </span>
                </li>
              ))}
            </ul>
          </div>

          {guidelineItems.map((item) => (
            <div>
              <h3 style="margin-bottom:8px">{item.title}</h3>
              <p>{item.description}</p>
            </div>
          ))}
        </div>

        <div class="hero-actions" style="margin-top:8px;margin-bottom:0">
          <a
            href={DISCORD_INVITE_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
          >
            Entrar no servidor do Discord ↗
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
