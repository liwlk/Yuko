---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  DOD_ITEMS,
  STACK_ITEMS,
  SECURITY_CARDS,
  LGPD_ITEMS,
  CONFLICT_STEPS,
  CONFLICT_PRINCIPLE,
} from '../data/yuko';
---

<BaseLayout
  title="Qualidade, Segurança, LGPD & Ética — Yuko Institucional"
  description="Critério de pronto, revisão de segurança por 2+ pares, cuidados pensando na LGPD (não substitui assessoria jurídica) e mediação de conflitos na Yuko."
  currentPath="/governanca/"
  footerVariant="compact"
  nextHref="/manual/"
  nextLabel="Ler Manual Completo v1.0 →"
>
  <section class="sub-hero">
    <div class="container">
      <div class="section-kicker">Qualidade &amp; Cuidado</div>
      <h1 class="sub-hero-title">
        Qualidade, <span class="accent-word">Segurança</span> &amp; Proteção de Dados
      </h1>
      <p class="hero-lead">
        Conferência antes da entrega, tecnologias conhecidas, revisão de segurança por 2+ pares e verificação de dependências, respeito à LGPD e mediação de impasses.
      </p>
      <div class="hero-actions" style="margin-bottom:0">
        <a href="#engenharia" class="btn btn-primary">Qualidade &amp; Conferência</a>
        <a href="#seguranca" class="btn btn-tonal">Segurança</a>
        <a href="#privacidade" class="btn btn-outline">LGPD &amp; Mediação</a>
      </div>
    </div>
  </section>

  <!-- Bloco 01: Padrões de Qualidade & Segurança -->
  <section id="engenharia" class="section" style="padding-top:24px">
    <div class="container">
      <div class="section-head">
        <div class="section-kicker">Base Técnica</div>
        <h2 class="section-title">Padrões de Qualidade &amp; Segurança</h2>
        <p class="section-desc">
          Sistemas do tamanho certo para a microempresa, com código limpo, tecnologias conhecidas e boas práticas de segurança desde o início.
        </p>
      </div>

      <div class="grid-2">
        <article class="m3-card tonal-primary">
          <div>
            <h3>Lista de Conferência Final (Critério de Pronto)</h3>
            <ul class="clean-list" style="margin-top:14px">
              {DOD_ITEMS.map((item) => (
                <li>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <span class="card-code">critério de pronto</span>
        </article>

        <article class="m3-card">
          <div>
            <h3>Tecnologias &amp; Histórico Organizado</h3>
            <ul class="clean-list" style="margin-top:14px">
              {STACK_ITEMS.map((item) => (
                <li>
                  <span>
                    <strong>{item.title}:</strong> {item.description}
                  </span>
                </li>
              ))}
            </ul>
          </div>
          <span class="card-code">tecnologias confiáveis</span>
        </article>
      </div>

      <div id="seguranca" class="grid-3" style="margin-top:24px">
        {SECURITY_CARDS.map((card, idx) => (
          <article class={idx === 1 ? 'm3-card tonal-secondary' : 'm3-card'}>
            <div>
              <h3 style="margin-bottom:8px">{card.title}</h3>
              <p>{card.description}</p>
            </div>
            <span class="card-code">{card.code}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Bloco 02: Privacidade (LGPD) & Mediação -->
  <section id="privacidade" class="section">
    <div class="container">
      <div class="section-head">
        <div class="section-kicker">Lei nº 13.709/2018 &amp; Boa Convivência</div>
        <h2 class="section-title">Privacidade (LGPD) &amp; Mediação</h2>
      </div>

      <div class="grid-2">
        <article class="m3-card tonal-tertiary">
          <div>
            <h3>Estrutura pensada para a LGPD</h3>
            <ul class="clean-list" style="margin-top:14px">
              {LGPD_ITEMS.map((item) => (
                <li>
                  <span>
                    <strong>{item.title}:</strong> {item.description}
                  </span>
                </li>
              ))}
            </ul>
          </div>
          <span class="card-code">lgpd · proteção de dados</span>
        </article>

        <article class="m3-card">
          <div>
            <h3>Mediação de Conflitos em 3 Passos</h3>
            <ul class="clean-list" style="margin-top:14px">
              {CONFLICT_STEPS.map((step) => (
                <li>
                  <span>
                    <strong>{step.title}:</strong> {step.description}
                  </span>
                </li>
              ))}
            </ul>
            <p style="margin-top:14px">
              <strong>{CONFLICT_PRINCIPLE.title}:</strong> {CONFLICT_PRINCIPLE.description}
            </p>
          </div>
          <span class="card-code">ética · resolução</span>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
