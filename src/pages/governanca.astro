---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  DOD_ITEMS,
  STACK_ITEMS,
  SECURITY_CARDS,
  LGPD_ITEMS,
  CONFLICT_STEPS,
  CONFLICT_PRINCIPLE,
} from '../data/yuko';
---

<BaseLayout
  title="Qualidade, Segurança, Arquitetura & LGPD — Yuko"
  description="Critério de pronto (DoD), tecnologias maduras sem dependência de nuvem (lock-in), proteção contra SQL Injection e XSS, Privacy by Design na LGPD e mediação."
  ogImageAlt="Padrões de qualidade, segurança, arquitetura simples e LGPD da Yuko"
  currentPath="/governanca/"
  footerVariant="compact"
  nextHref="/manual/"
  nextLabel="Ler Manual Completo v1.0 →"
>
  <section class="sub-hero">
    <div class="container">
      <div class="section-kicker">Qualidade &amp; Cuidado</div>
      <h1 class="sub-hero-title">
        Qualidade, <span class="accent-word">Segurança</span> &amp; Proteção de Dados
      </h1>
      <p class="hero-lead">
        Sistemas enxutos sem dependência de nuvem (lock-in), conferência rigorosa de pronto (DoD), proteção de código contra SQL Injection e XSS, e LGPD com Privacy by Design.
      </p>
      <div class="hero-actions" style="margin-bottom:0">
        <a href="#engenharia" class="btn btn-primary">Qualidade &amp; Arquitetura</a>
        <a href="#seguranca" class="btn btn-tonal">Segurança</a>
        <a href="#privacidade" class="btn btn-outline">LGPD &amp; Mediação</a>
      </div>
    </div>
  </section>

  <!-- Bloco 01: Padrões de Qualidade & Segurança -->
  <section id="engenharia" class="section" style="padding-top:24px">
    <div class="container">
      <div class="section-head">
        <div class="section-kicker">Base Técnica &amp; Escolhas</div>
        <h2 class="section-title">Padrões de Qualidade, Arquitetura &amp; Segurança</h2>
        <p class="section-desc">
          Sistemas do tamanho certo para a microempresa: arquitetura simples com tecnologias maduras para evitar custos excessivos e dependência de nuvem (lock-in), com proteção desde o início.
        </p>
      </div>

      <div class="grid-2">
        <article class="m3-card tonal-primary">
          <div>
            <h3>Lista de Conferência Final (Definition of Done)</h3>
            <ul class="clean-list" style="margin-top:14px">
              {DOD_ITEMS.map((item) => (
                <li>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <span class="card-code">definition of done</span>
        </article>

        <article class="m3-card">
          <div>
            <h3>Arquitetura Simples &amp; Sem Lock-in</h3>
            <ul class="clean-list" style="margin-top:14px">
              {STACK_ITEMS.map((item) => (
                <li>
                  <span>
                    <strong>{item.title}:</strong> {item.description}
                  </span>
                </li>
              ))}
            </ul>
          </div>
          <span class="card-code">tecnologias maduras</span>
        </article>
      </div>

      <div id="seguranca" class="grid-3" style="margin-top:24px">
        {SECURITY_CARDS.map((card, idx) => (
          <article class={idx === 1 ? 'm3-card tonal-secondary' : 'm3-card'}>
            <div>
              <h3 style="margin-bottom:8px">{card.title}</h3>
              <p>{card.description}</p>
            </div>
            <span class="card-code">{card.code}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Bloco 02: Privacidade (LGPD) & Mediação -->
  <section id="privacidade" class="section">
    <div class="container">
      <div class="section-head">
        <div class="section-kicker">Lei nº 13.709/2018 &amp; Boa Convivência</div>
        <h2 class="section-title">LGPD, Privacy by Design &amp; Regra de Ouro</h2>
      </div>

      <div class="grid-2">
        <article class="m3-card tonal-tertiary">
          <div>
            <h3>Privacidade desde o Desenho (Privacy by Design)</h3>
            <ul class="clean-list" style="margin-top:14px">
              {LGPD_ITEMS.map((item) => (
                <li>
                  <span>
                    <strong>{item.title}:</strong> {item.description}
                  </span>
                </li>
              ))}
            </ul>
          </div>
          <span class="card-code">lgpd · privacy by design</span>
        </article>

        <article class="m3-card">
          <div>
            <h3>Mediação de Conflitos em 3 Passos</h3>
            <ul class="clean-list" style="margin-top:14px">
              {CONFLICT_STEPS.map((step) => (
                <li>
                  <span>
                    <strong>{step.title}:</strong> {step.description}
                  </span>
                </li>
              ))}
            </ul>
            <p style="margin-top:14px">
              <strong>{CONFLICT_PRINCIPLE.title}:</strong> {CONFLICT_PRINCIPLE.description}
            </p>
          </div>
          <span class="card-code">ética · resolução</span>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
