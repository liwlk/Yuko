---
import BaseLayout from '../layouts/BaseLayout.astro';
import SplitButton from '../components/SplitButton';
import HeroSculpture from '../components/HeroSculpture';
import YukoContinuityStage from '../components/YukoContinuityStage';
import YukoOrderSimulator from '../components/YukoOrderSimulator';
import {
  AUDIENCE_CARDS,
  CONTINUITY_STAGES,
  DISCORD_INVITE_URL,
  HERO_METRICS,
  HOME_PILLARS,
  SPLIT_SHORTCUTS,
} from '../data/yuko';
---

<BaseLayout
  title="Yuko — Parceria Assistida entre Devs Independentes e Microempresas"
  description="Comunidade técnica que tira devs do isolamento e livra microempresas da caixa-preta: trabalho individual validado por 2+ pares, repositório central, LGPD e continuidade assistida."
  ogImageAlt="Yuko — Parceria Assistida entre Devs Independentes e Microempresas"
  currentPath="/"
  footerVariant="monument"
>
  <!-- Hero Section -->
  <section class="hero" aria-labelledby="heroHeading">
    <div class="container hero-grid">
      <div>
        <h1 id="heroHeading" class="hero-title">
          Software com <span class="accent-word">exatidão</span> coletiva para projetos.
        </h1>

        <p class="hero-lead">
          No isolamento, uma emergência do dev trava o projeto e deixa a empresa sem suporte. Na parceria assistida da Yuko, há trabalho individual validado coletivamente: repositório central, 2+ revisores e continuidade sem caixa-preta.
        </p>

        <div class="hero-actions">
          <SplitButton
            client:load
            mainLabel="Conhecer o Ciclo Assistido"
            mainHref="/ciclo/"
            items={SPLIT_SHORTCUTS}
          />

          <a href="/manual/" class="btn btn-tonal">Consultar Manual v1.0</a>
        </div>

        <div class="hero-metrics" aria-label="Indicadores estruturais da Yuko">
          {HERO_METRICS.map((metric) => (
            <div class="metric-pill">
              <span class="metric-val">{metric.value}</span>
              <span class="metric-label">{metric.label}</span>
            </div>
          ))}
        </div>
      </div>

      <HeroSculpture client:load />
    </div>
  </section>

  <!-- Por que nenhum projeto fica na mão -->
  <section id="continuidade" class="stage-section" aria-labelledby="continuidadeHeading">
    <div class="container">
      <YukoContinuityStage
        client:load
        stages={CONTINUITY_STAGES}
        headingId="continuidadeHeading"
      />
    </div>
  </section>

  <!-- 3 Pilares Estruturais -->
  <section id="pilares" class="section" aria-labelledby="pilaresHeading">
    <div class="container">
      <div class="section-head">
        <div class="section-kicker">Como a rede funciona</div>
        <h2 id="pilaresHeading" class="section-title">Engrenagens claras, do pedido ao suporte</h2>
        <p class="section-desc">
          Seis extensões integradas, um ciclo de seis etapas sem caixa-preta e simplicidade técnica com foco em LGPD.
        </p>
      </div>

      <div class="features-grid">
        {HOME_PILLARS.map((pillar) => (
          <a href={pillar.href} class={`feature-card feature-${pillar.variant}`}>
            <div>
              <div class="feature-shape-icon" aria-hidden="true">
                {pillar.variant === 'arch' && (
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 3v18M3 12h18" />
                  </svg>
                )}
                {pillar.variant === 'xl' && (
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <path d="M4 12h4l3-7 4 14 3-7h2" />
                  </svg>
                )}
                {pillar.variant === 'soft' && (
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <rect x="4" y="10" width="16" height="10" rx="4" />
                    <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                  </svg>
                )}
              </div>
              <h3>{pillar.title}</h3>
              <p class={pillar.topics?.length ? 'feature-intro' : undefined}>{pillar.description}</p>
              {pillar.topics && pillar.topics.length > 0 && (
                <ul class="feature-topics">
                  {pillar.topics.map((topic) => (
                    <li>
                      <span class="feature-topic-dot" aria-hidden="true" />
                      <span>
                        <strong>{topic.title}</strong> — {topic.detail}
                      </span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
            <span class="feature-tag">{pillar.tag}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 2 Públicos (Microempresas vs Desenvolvedores) -->
  <section id="atuacao" class="section" aria-labelledby="atuacaoHeading">
    <div class="container">
      <div class="plans-header">
        <div>
          <div class="section-kicker">Parceria assistida</div>
          <h2 id="atuacaoHeading" class="section-title" style="margin-bottom:0">
            Fim do isolamento para quem cria, fim da caixa-preta para quem contrata
          </h2>
        </div>
      </div>

      <div class="plans-grid">
        {AUDIENCE_CARDS.map((card) => (
          <article
            id={card.id}
            class={card.featured ? 'plan-card featured' : 'plan-card'}
          >
            <div>
              <span class="studio-badge">{card.badge}</span>
              <h3 class="audience-title">{card.title}</h3>
              <p>{card.description}</p>
              <ul class="clean-list">
                {card.bullets.map((bullet) => (
                  <li><span>{bullet}</span></li>
                ))}
              </ul>
            </div>
            <div class="hero-actions" style="margin-bottom:0">
              <a
                href={card.ctaHref}
                class={card.ctaVariant === 'primary' ? 'btn btn-primary' : 'btn btn-outline'}
              >
                {card.ctaLabel}
              </a>
              {card.secondaryCtaLabel && card.secondaryCtaHref && (
                <a
                  href={card.secondaryCtaHref}
                  target={card.secondaryExternal ? '_blank' : undefined}
                  rel={card.secondaryExternal ? 'noopener noreferrer' : undefined}
                  class="btn btn-tonal"
                >
                  {card.secondaryCtaLabel}
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Simulador Prático de Pedido & Atuação na Comunidade -->
  <section id="simulador" class="section" aria-labelledby="simuladorHeading">
    <div class="container">
      <div class="section-head">
        <div class="section-kicker">Simulador de Parceria</div>
        <h2 id="simuladorHeading" class="section-title">
          Veja como seu projeto ou atuação entra na rede
        </h2>
        <p class="section-desc">
          Alterne entre Empresa, Cliente ou Dev para explorar prazos indicativos, faixa de complexidade (sem R$ fechado), cuidados de LGPD e gerar a ficha pronta para triagem no Discord.
        </p>
      </div>

      <YukoOrderSimulator client:load />
    </div>
  </section>

  <!-- CTA Manual Institucional v1.0 & Discord -->
  <section id="manual" class="section" aria-labelledby="manualCtaHeading" style="padding-block:16px 24px">
    <div class="container">
      <div class="cta-banner">
        <div>
          <h2 id="manualCtaHeading">Leia o Manual v1.0 ou chegue junto no Discord</h2>
          <p>
            Consulte as regras do Ciclo de 6 etapas, o DoD de segurança e a LGPD no Manual (guia orientativo, sem caráter contratual), ou participe da convivência diária no Discord — espaço voluntário e autônomo, sem vínculo empregatício ou societário.
          </p>
        </div>
        <div class="hero-actions" style="margin-bottom:0">
          <a href="/manual/" class="btn btn-primary">Abrir Manual v1.0</a>
          <a
            href={DISCORD_INVITE_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-tonal"
          >
            Entrar no Discord ↗
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
