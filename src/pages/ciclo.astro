---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  CYCLE_STAGES,
  DISCORD_INVITE_URL,
  TRIAGE_CRITERIA,
  ROLES,
  CONTINUITY_RULES,
  REGISTRY_COL_A,
  REGISTRY_COL_B,
} from '../data/yuko';
const triageColA = TRIAGE_CRITERIA.slice(0, 2);
const triageColB = TRIAGE_CRITERIA.slice(2);
---

<BaseLayout
  title="Ciclo de Entrega Assistida, Papéis & Registro — Yuko"
  description="As 6 etapas do Ciclo de Entrega Assistida, papéis do projeto, regra de vacância em 5 dias úteis e ficha de acompanhamento na comunidade Yuko."
  currentPath="/ciclo/"
  footerVariant="compact"
  nextHref="/governanca/"
  nextLabel="Avançar para Qualidade & LGPD →"
>
  <section class="sub-hero">
    <div class="container">
      <div class="section-kicker">Do Pedido ao Suporte</div>
      <h1 class="sub-hero-title">
        O <span class="accent-word">Ciclo</span> de Entrega Assistida
      </h1>
      <p class="hero-lead">
        Combinado claro, revisão por 2+ pares, testes antes da entrega e responsável de suporte nomeado pelo período combinado nas 6 etapas do Ciclo.
      </p>
      <div class="hero-actions" style="margin-bottom:0">
        <a href="#etapas" class="btn btn-primary">As 6 Etapas</a>
        <a href="#papeis" class="btn btn-tonal">Papéis &amp; Continuidade</a>
        <a href="#registro" class="btn btn-outline">Ficha do Projeto</a>
      </div>
    </div>
  </section>

  <!-- As 6 Etapas -->
  <section id="etapas" class="section" style="padding-top:24px">
    <div class="container">
      <div class="section-head">
        <div class="section-kicker">Fluxo do Ciclo</div>
        <h2 class="section-title">6 etapas do Ciclo, do pedido ao suporte</h2>
      </div>

      <div class="grid-3 pipeline-grid">
        {CYCLE_STAGES.map((stage) => (
          <article class={stage.tone === 'default' ? 'm3-card' : `m3-card ${stage.tone}`}>
            <span class="stage-step-badge">{stage.code}</span>
            <div>
              <h3 style="margin-bottom:8px">{stage.title}</h3>
              <p>{stage.description}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="lab-panel" style="margin-top:24px">
        <h3 style="margin-bottom:14px">Como avaliamos e priorizamos cada pedido</h3>
        <div class="grid-2">
          <ul class="clean-list">
            {triageColA.map((criterion) => (
              <li>
                <span>
                  <strong>{criterion.title}:</strong> {criterion.description}
                </span>
              </li>
            ))}
          </ul>
          <ul class="clean-list">
            {triageColB.map((criterion) => (
              <li>
                <span>
                  <strong>{criterion.title}:</strong> {criterion.description}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Papéis & Continuidade -->
  <section id="papeis" class="section">
    <div class="container">
      <div class="section-head">
        <div class="section-kicker">Quem Faz o Quê</div>
        <h2 class="section-title">Papéis funcionais e regra de continuidade</h2>
        <p class="section-desc">
          Cada projeto divide responsabilidades de forma clara para dar respaldo técnico à microempresa sem sobrecarregar ninguém.
        </p>
      </div>

      <div class="grid-3">
        {ROLES.map((role) => (
          <article class={role.tone === 'default' ? 'm3-card' : `m3-card ${role.tone}`}>
            <h3>{role.title}</h3>
            <p>{role.description}</p>
          </article>
        ))}
      </div>

      <div class="grid-2" style="margin-top:20px">
        {CONTINUITY_RULES.map((rule) => (
          <article class={rule.tone === 'default' ? 'm3-card' : `m3-card ${rule.tone}`}>
            <h3>{rule.title}</h3>
            <p>{rule.description}</p>
          </article>
        ))}
      </div>

      <div class="hero-actions" style="margin-top:24px;margin-bottom:0">
        <a
          href={DISCORD_INVITE_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
        >
          Acompanhar projetos no Discord ↗
        </a>
        <a href="/governanca/" class="btn btn-tonal">Ver qualidade &amp; segurança</a>
      </div>
    </div>
  </section>

  <!-- Registro Formal -->
  <section id="registro" class="section">
    <div class="container">
      <div class="section-head">
        <div class="section-kicker">Tudo Documentado</div>
        <h2 class="section-title">Nada fica só no combinado de boca</h2>
        <p class="section-desc">
          É proibido assumir projetos com o nome da Yuko apenas por conversa informal; toda iniciativa precisa de uma ficha oficial de acompanhamento (issue de registro).
        </p>
      </div>

      <div class="m3-card">
        <h3>O que precisa constar em cada ficha do projeto</h3>
        <div class="grid-2">
          <ul class="clean-list">
            {REGISTRY_COL_A.map((item) => (
              <li>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <ul class="clean-list">
            {REGISTRY_COL_B.map((item) => (
              <li>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
