---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlossaryExplorer from '../components/GlossaryExplorer';
import {
  CONTROL_TABLE,
  MANUAL_ORIGINS,
  GLOSSARY_TERMS,
} from '../data/yuko';

const glossaryTerms = GLOSSARY_TERMS.map((item) => ({
  term: item.term,
  definition: item.definition,
  tone: item.tone ?? 'default',
}));
---

<BaseLayout
  title="Manual Institucional v1.0 & Glossário — Yuko"
  description="Regras públicas do Manual Institucional v1.0, ressalvas jurídicas, linhagem NYX → Expliance → Yuko, gestão enxuta e glossário pesquisável."
  ogImageAlt="Manual Institucional v1.0 da Yuko e glossário pesquisável"
  currentPath="/manual/"
  footerVariant="compact"
  nextHref="/"
  nextLabel="Voltar ao Início →"
>
  <section class="sub-hero">
    <div class="container">
      <div class="section-kicker">Documentação de Referência · v1.0</div>
      <h1 class="sub-hero-title">
        Manual Institucional da <span class="accent-word">Yuko</span> — v1.0
      </h1>
      <p class="hero-lead">
        Boas-vindas à documentação de referência da Yuko: confira as regras públicas da comunidade, avisos legais, a trajetória NYX → Expliance → Yuko e um glossário expandido e pesquisável para traduzir cada termo para o dia a dia.
      </p>
      <div class="hero-actions" style="margin-bottom:0">
        <a href="#controle" class="btn btn-primary">Quadro de Controle</a>
        <a href="#origem" class="btn btn-tonal">Ressalvas &amp; Linhagem</a>
        <a href="#glossario" class="btn btn-outline">Glossário</a>
      </div>
    </div>
  </section>

  <!-- Quadro de Controle -->
  <section id="controle" class="section" style="padding-top:24px">
    <div class="container">
      <div class="section-head">
        <div class="section-kicker">Ficha do Documento</div>
        <h2 class="section-title">Quadro de Controle do Documento</h2>
      </div>

      <div class="control-table-wrap">
        <table class="control-table" role="table">
          <caption class="sr-only">
            Metadados normativos e de versão do Manual Institucional da Yuko v1.0
          </caption>
          <tbody role="rowgroup">
            {CONTROL_TABLE.map((row) => (
              <tr role="row">
                <th scope="row" role="rowheader">{row.label}</th>
                <td role="cell">{row.value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Ressalvas, Linhagem & Guia -->
  <section id="origem" class="section">
    <div class="container">
      <div class="section-head">
        <div class="section-kicker">História &amp; Regras Gerais</div>
        <h2 class="section-title">Ressalvas Jurídicas, Linhagem &amp; Gestão Enxuta</h2>
      </div>

      <div class="grid-2">
        {MANUAL_ORIGINS.map((card) => (
          <article class={card.tone === 'default' ? 'm3-card' : `m3-card ${card.tone}`}>
            {card.links ? (
              <div>
                <h3>{card.title}</h3>
                <ul class="clean-list" style="margin-top:12px">
                  {card.links.map((link) => (
                    <li>
                      <span>
                        <a href={link.href}>
                          <strong>{link.label}</strong>
                        </a>{' '}
                        — {link.description}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            ) : (
              <>
                <h3>{card.title}</h3>
                {card.paragraphs?.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
                {card.lineage?.map((entry) => (
                  <p>
                    <strong>{entry.label}:</strong> {entry.text}
                  </p>
                ))}
              </>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Glossário Institucional -->
  <section id="glossario" class="section">
    <div class="container">
      <div class="section-head">
        <div class="section-kicker">Dicionário da Yuko</div>
        <h2 class="section-title">Termos oficiais do Manual v1.0</h2>
        <p class="section-desc">
          Pesquise qualquer termo técnico ou oficial do Manual v1.0 — da chancela coletiva à Regra de Ouro da LGPD — para ver o que ele significa na prática.
        </p>
      </div>

      <GlossaryExplorer client:load terms={glossaryTerms} />
    </div>
  </section>
</BaseLayout>
