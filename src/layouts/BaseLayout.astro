---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import SiteIntro from '../components/SiteIntro.astro';

export interface Props {
  title: string;
  description: string;
  currentPath: string;
  footerVariant?: 'monument' | 'compact';
  nextHref?: string;
  nextLabel?: string;
  footerSummary?: string;
  ogImageAlt?: string;
}

const {
  title,
  description,
  currentPath,
  footerVariant = 'compact',
  nextHref,
  nextLabel,
  footerSummary,
  ogImageAlt = 'Símbolo e marca Yuko — Parceria Assistida entre Devs Independentes e Microempresas',
} = Astro.props;

const siteOrigin = Astro.site?.toString().replace(/\/$/, '') ?? 'https://yuko-one.vercel.app';
const canonicalUrl = new URL(currentPath || '/', `${siteOrigin}/`).toString();
const ogImageUrl = new URL('/assets/og-yuko-v2.png', `${siteOrigin}/`).toString();
---

<!DOCTYPE html>
<html lang="pt-BR" data-seed="terracota" data-mode="light" data-motion="expressive">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#a93714" />

    <!-- Open Graph / Discord / WhatsApp / LinkedIn -->
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Yuko" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link id="yukoFavicon" rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
    <script is:inline>
      (function () {
        var ALLOWED_SEEDS = ['terracota', 'botanico', 'oceanico', 'ameixa'];
        var ALLOWED_MODES = ['light', 'dark'];
        var ALLOWED_MOTIONS = ['expressive', 'calm'];
        var FAVICON_PALETTES = {
          terracota: {
            light: { bg: '#ffdbd0', fg: '#a93714' },
            dark: { bg: '#862403', fg: '#ffdbd0' },
          },
          botanico: {
            light: { bg: '#c1f1cd', fg: '#276841' },
            dark: { bg: '#0c512d', fg: '#c1f1cd' },
          },
          oceanico: {
            light: { bg: '#d4e3ff', fg: '#1d5796' },
            dark: { bg: '#004786', fg: '#d4e3ff' },
          },
          ameixa: {
            light: { bg: '#ffd8ec', fg: '#7d3b66' },
            dark: { bg: '#63234e', fg: '#ffd8ec' },
          },
        };
        var YUKO_FAVICON_PATH =
          'M31.4 10.1C32.1 10.2 33.9 10.4 34.6 11.2C35.2 12.0 35.2 13.6 35.1 14.8C34.9 15.9 34.2 16.9 33.9 18.1C33.6 19.3 33.2 20.7 33.2 21.9C33.3 23.1 33.5 25.0 34.1 25.5C34.8 25.9 36.3 25.1 37.2 24.5C38.0 23.9 38.6 22.9 39.2 22.0C39.8 21.1 40.1 19.9 40.6 19.0C41.2 18.0 41.6 16.8 42.5 16.4C43.4 16.0 45.2 16.0 45.9 16.6C46.7 17.1 47.3 18.8 47.2 19.7C47.1 20.7 46.1 21.6 45.3 22.3C44.5 23.0 43.2 23.2 42.3 23.8C41.4 24.3 40.4 24.8 39.7 25.6C39.0 26.4 38.0 27.7 38.2 28.5C38.3 29.4 39.6 30.2 40.7 30.5C41.8 30.7 43.5 30.4 44.7 30.1C45.9 29.8 46.8 29.0 47.9 28.8C49.0 28.7 50.7 28.6 51.5 29.2C52.3 29.8 52.9 31.4 52.8 32.3C52.7 33.3 51.8 34.5 50.9 35.0C50.0 35.4 48.4 35.0 47.2 34.8C46.1 34.6 45.2 33.9 44.0 33.6C42.8 33.2 41.4 33.2 40.1 32.9C38.9 32.6 37.5 32.6 36.6 31.9C35.8 31.3 35.9 29.7 35.0 29.1C34.2 28.4 32.3 28.9 31.5 28.2C30.7 27.6 30.5 26.2 30.4 24.9C30.2 23.7 30.6 22.0 30.5 20.6C30.4 19.3 29.9 18.3 29.6 17.1C29.3 15.9 28.6 14.6 28.6 13.5C28.7 12.4 29.6 11.1 30.1 10.5C30.5 9.9 30.6 9.9 31.4 10.1Z M19.4 16.0C19.8 16.1 21.2 16.3 21.8 16.7C22.4 17.2 22.7 18.0 23.1 18.7C23.5 19.4 23.8 20.2 24.1 21.0C24.5 21.7 24.9 22.4 25.3 23.1C25.8 23.7 26.3 24.2 26.8 24.9C27.2 25.6 27.9 26.6 27.8 27.0C27.6 27.4 26.5 27.4 25.9 27.2C25.3 26.9 24.8 26.1 24.2 25.6C23.6 25.1 23.0 24.6 22.3 24.2C21.6 23.8 20.9 23.4 20.2 23.1C19.4 22.7 18.6 22.5 18.0 22.0C17.4 21.4 16.8 20.8 16.7 20.0C16.5 19.2 16.8 18.1 17.2 17.4C17.6 16.8 18.7 16.3 19.1 16.1C19.5 15.8 18.9 15.9 19.4 16.0Z M14.0 28.7C14.8 28.7 16.4 29.2 17.6 29.5C18.8 29.8 19.8 30.3 21.0 30.6C22.2 30.9 23.8 30.8 24.9 31.1C26.1 31.5 27.4 31.7 28.0 32.5C28.7 33.3 28.8 34.9 28.6 35.9C28.5 36.9 27.5 37.8 26.9 38.7C26.3 39.5 25.6 40.3 25.1 41.3C24.5 42.2 24.1 43.3 23.6 44.3C23.0 45.2 22.7 46.5 21.9 47.1C21.1 47.7 19.5 48.0 18.6 47.6C17.7 47.3 16.8 46.0 16.7 45.1C16.6 44.1 17.3 42.8 18.0 42.0C18.7 41.2 20.0 41.0 21.0 40.5C21.9 39.9 22.9 39.4 23.7 38.7C24.4 38.0 25.5 36.9 25.5 36.0C25.5 35.2 24.7 33.9 23.8 33.5C22.8 33.1 21.1 33.4 19.9 33.7C18.6 33.9 17.7 34.7 16.6 34.9C15.4 35.1 13.8 35.4 12.9 34.9C12.0 34.4 11.2 33.0 11.2 32.1C11.2 31.1 12.3 29.7 12.8 29.2C13.2 28.6 13.2 28.6 14.0 28.7Z M34.6 34.8C35.2 35.0 36.8 35.6 37.7 36.2C38.5 36.8 39.1 37.7 40.0 38.4C40.8 39.0 41.6 39.7 42.6 40.2C43.5 40.8 44.8 41.0 45.6 41.7C46.4 42.4 47.3 43.5 47.3 44.4C47.4 45.4 46.6 46.9 45.8 47.4C45.0 47.9 43.3 47.9 42.5 47.4C41.6 47.0 41.2 45.7 40.6 44.8C40.0 43.9 39.7 42.7 39.1 41.8C38.6 40.8 38.0 39.8 37.1 39.3C36.2 38.9 34.6 38.6 34.0 39.2C33.3 39.7 33.2 41.6 33.3 42.8C33.3 44.0 33.8 45.3 34.1 46.4C34.5 47.6 35.3 48.6 35.3 49.7C35.3 50.9 35.0 52.4 34.3 53.1C33.5 53.7 31.8 54.1 30.9 53.8C30.0 53.6 29.0 52.5 28.8 51.5C28.5 50.5 29.0 48.9 29.3 47.8C29.6 46.6 30.2 45.7 30.5 44.4C30.7 43.2 30.7 41.7 31.0 40.4C31.2 39.2 31.3 37.8 31.9 36.9C32.5 36.0 33.9 35.2 34.3 34.9C34.8 34.5 34.1 34.6 34.6 34.8Z';

        function getSystemMode() {
          try {
            if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
              return 'dark';
            }
          } catch (_e) {
            // Ignore matchMedia errors
          }
          return 'light';
        }

        function hasManualMode() {
          try {
            var m = localStorage.getItem('yuko_mode');
            return Boolean(m && ALLOWED_MODES.indexOf(m) > -1);
          } catch (_e) {
            return false;
          }
        }

        function readPrefs() {
          var seed = 'terracota';
          var mode = getSystemMode();
          var motion = 'expressive';
          try {
            var s = localStorage.getItem('yuko_seed');
            var m = localStorage.getItem('yuko_mode');
            var t = localStorage.getItem('yuko_motion');
            if (s && ALLOWED_SEEDS.indexOf(s) > -1) seed = s;
            if (m && ALLOWED_MODES.indexOf(m) > -1) mode = m;
            if (t && ALLOWED_MOTIONS.indexOf(t) > -1) motion = t;
          } catch (_e) {
            // Ignore storage access errors
          }
          return { seed: seed, mode: mode, motion: motion };
        }

        function updateFavicon(targetDoc, seed, mode) {
          var doc = targetDoc || document;
          var palette = FAVICON_PALETTES[seed] || FAVICON_PALETTES.terracota;
          var colors = palette[mode === 'dark' ? 'dark' : 'light'];
          var svg =
            '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none">' +
            '<rect width="64" height="64" rx="18" fill="' + colors.bg + '"/>' +
            '<path fill="' + colors.fg + '" d="' + YUKO_FAVICON_PATH + '"/>' +
            '</svg>';
          var href = 'data:image/svg+xml,' + encodeURIComponent(svg);
          var link = doc.getElementById('yukoFavicon') || doc.querySelector('link[rel="icon"]');
          if (!link && doc.head) {
            link = doc.createElement('link');
            link.id = 'yukoFavicon';
            link.rel = 'icon';
            link.type = 'image/svg+xml';
            doc.head.appendChild(link);
          }
          if (link) {
            if (!link.id) link.id = 'yukoFavicon';
            link.rel = 'icon';
            link.type = 'image/svg+xml';
            if (link.getAttribute('href') !== href) {
              link.setAttribute('href', href);
            }
          }
        }

        function applyPrefsToDocument(targetDoc) {
          var doc = targetDoc || document;
          var root = doc.documentElement;
          if (!root) return;
          var prefs = readPrefs();
          root.setAttribute('data-seed', prefs.seed);
          root.setAttribute('data-mode', prefs.mode);
          root.setAttribute('data-motion', prefs.motion);
          if (window.__yukoIntroCompleted) {
            root.setAttribute('data-intro-done', 'true');
            root.removeAttribute('data-intro-active');
            var introEl = doc.getElementById('yukoIntro');
            if (introEl) introEl.setAttribute('hidden', '');
          } else if (root.getAttribute('data-intro-done') !== 'true') {
            root.setAttribute('data-intro-active', 'true');
          }
          updateFavicon(doc, prefs.seed, prefs.mode);
        }

        applyPrefsToDocument(document);

        if (!window.__yukoThemeSwapReady) {
          window.__yukoThemeSwapReady = true;
          document.addEventListener('astro:before-swap', function (ev) {
            if (ev && ev.newDocument) {
              applyPrefsToDocument(ev.newDocument);
            }
          });
          document.addEventListener('astro:after-swap', function () {
            applyPrefsToDocument(document);
          });
          if (window.matchMedia) {
            var mql = window.matchMedia('(prefers-color-scheme: dark)');
            var onSystemChange = function () {
              if (!hasManualMode()) {
                applyPrefsToDocument(document);
              }
            };
            if (typeof mql.addEventListener === 'function') {
              mql.addEventListener('change', onSystemChange);
            } else if (typeof mql.addListener === 'function') {
              mql.addListener(onSystemChange);
            }
          }
        }
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&family=JetBrains+Mono:wght@500;700&display=swap"
    />
    <noscript><style>#yukoIntro{display:none!important}</style></noscript>
    <ClientRouter />
  </head>
  <body>
    <SiteIntro />
    <div id="topo-pagina" aria-hidden="true"></div>
    <div id="yukoScrollProgress" class="scroll-progress-bar" aria-hidden="true"></div>
    <a class="skip-link" href="#topo">Pular para o conteúdo</a>

    <TopBar currentPath={currentPath} />

    <main id="topo" tabindex="-1" transition:name="yuko-stage">
      <slot />
    </main>

    <Footer
      variant={footerVariant}
      currentPath={currentPath}
      nextHref={nextHref}
      nextLabel={nextLabel}
      summary={footerSummary}
    />

    <div id="toast" class="toast" role="status" aria-live="polite"></div>

    <script>
      import { initLenis } from '../scripts/lenis-manager';
      import { initChoreography } from '../scripts/scroll-choreography';
      import { initSiteIntro } from '../scripts/site-intro';

      declare global {
        interface Window {
          __yukoToastReady?: boolean;
          __yukoLifecycleBooted?: boolean;
        }
      }

      let toastTimer: number | undefined;

      function showToast(message: string) {
        const toastEl = document.getElementById('toast');
        if (!toastEl || !message) return;
        toastEl.textContent = message;
        toastEl.classList.add('show');
        if (toastTimer !== undefined) {
          window.clearTimeout(toastTimer);
        }
        toastTimer = window.setTimeout(() => {
          toastEl.classList.remove('show');
        }, 2500);
      }

      function handleToastEvent(event: Event) {
        const customEvent = event as CustomEvent<{ message?: string } | string>;
        const detail = customEvent.detail;
        const message = typeof detail === 'string' ? detail : detail?.message;
        if (message) {
          showToast(message);
        }
      }

      if (!window.__yukoToastReady) {
        window.__yukoToastReady = true;
        window.addEventListener('yuko:toast', handleToastEvent);
      }

      if (!window.__yukoLifecycleBooted) {
        window.__yukoLifecycleBooted = true;
        if (document.readyState !== 'loading') {
          initSiteIntro();
          initLenis();
          initChoreography();
        } else {
          document.addEventListener(
            'DOMContentLoaded',
            () => {
              initSiteIntro();
              initLenis();
              initChoreography();
            },
            { once: true }
          );
        }
      }
    </script>
  </body>
</html>
